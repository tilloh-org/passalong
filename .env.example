# Copy to .env and adjust if needed.
# All values are optional; defaults are shown.

# Host port for the passalong container (default: 4242)
PASSALONG_PORT=4242

# Docker container name (default: passalong). Set a distinct value when a second
# passalong stack runs on the same Docker host, for example passalong-staging.
# PASSALONG_CONTAINER_NAME=passalong-staging

# Optional JSON bootstrap manifest. Keep it to one line in .env.
# On an empty database, provide exactly one account with instanceAdmin set to true.
# Existing accounts are checked and never updated or deleted; remove this value after initial setup if preferred.
# PASSALONG_BOOTSTRAP={"accounts":[{"tenantName":"Example household","username":"admin","displayName":"Example admin","password":"replace-with-a-unique-password","instanceAdmin":true}]}

# Commit hash shown in the global footer as `v<release>-<commit-hash>`.
# Docker builds cannot read `.git` (it is excluded from the build context), so the
# hash is injected as a build argument. Set it to the short commit you are deploying:
# COMMIT_HASH=$(git rev-parse --short=7 HEAD)
